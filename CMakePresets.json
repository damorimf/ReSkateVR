{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "environment": {
        "VCLibPackagePath": "${sourceDir}/build/no-vcpkg/vcpkg.user"
      },
      "toolset": "v143"
    },
    {
      "name": "vr-v1",
      "displayName": "ReSkate VR V1 development",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/build/vr-v1",
      "cacheVariables": {
        "DINGOSDK_VERSION": "1.0.0-dev",
        "DINGOSDK_BUILD_VR_TESTS": "ON",
        "DINGOSDK_BUILD_MULTIPLAYER_TESTS": "ON",
        "DINGOSDK_LAUNCHER_AUTO_UPDATE": "OFF",
        "DINGOSDK_BACKTRACE_URL": ""
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (dedicated server only)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "vr-v1-release",
      "configurePreset": "vr-v1",
      "configuration": "Release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64"
    }
  ]
}
